{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "none",
	"insertFinalNewline": false,
	"ignorePatterns": [".claude", "dist", "package-lock.json"],
	"overrides": [
		{
			"files": ["*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2,
				"embeddedLanguageFormatting": "off"
			}
		},
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}