{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"framework": [
		{
			"name": "playground",
			"enablers": ["eslint"],
			"entryPoints": ["playground/*/App.{tsx,vue,svelte}"],
			"entryPointRole": "support"
		},
		{
			"name": "bench",
			"enablers": ["tinybench"],
			"entryPoints": ["bench/*.ts"],
			"entryPointRole": "support"
		}
	],
	"ignorePatterns": ["scripts/**"],
	"ignoreDependencies": ["typescript7"],
	"rules": {}
}