{
	"name": "slot-variants",
	"version": "1.4.0",
	"description": "Type-safe class name variants with slots",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./eslint-plugin": {
			"types": "./dist/eslint-plugin.d.ts",
			"import": "./dist/eslint-plugin.js",
			"require": "./dist/eslint-plugin.cjs"
		}
	},
	"sideEffects": false,
	"files": [
		"SKILL.md",
		"dist",
		"logo.svg"
	],
	"scripts": {
		"bench": "jiti bench/cn.ts && jiti bench/cva.ts && jiti bench/tv.ts",
		"build": "tsup src/index.ts src/eslint-plugin.ts && rm dist/index.d.cts dist/eslint-plugin.d.cts",
		"fallow": "npm t && tap report json && node scripts/sanitize-tap-coverage.mjs && fallow health --coverage .tap/report/coverage-final.json",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"lint": "eslint src",
		"prepublishOnly": "npm run build",
		"test": "tap --show-full-coverage test/*.test.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/micnic/slot-variants.git"
	},
	"homepage": "https://github.com/micnic/slot-variants",
	"bugs": {
		"url": "https://github.com/micnic/slot-variants/issues"
	},
	"keywords": [
		"classes",
		"classname",
		"classnames",
		"variants",
		"slots"
	],
	"author": "Nicu Micleușanu",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/estree": "1.0.9",
		"class-variance-authority": "0.7.1",
		"classnames": "2.5.1",
		"eslint": "10.3.0",
		"fallow": "^2.62.0",
		"jiti": "2.7.0",
		"oxlint": "1.63.0",
		"prettier": "3.8.3",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.2.2",
		"tap": "21.7.2",
		"tinybench": "6.0.1",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.2"
	},
	"tsup": {
		"dts": true,
		"format": [
			"cjs",
			"esm"
		]
	}
}
